@page "/"
@using SpacecraftMaintenanceStation.BlazorWasm.Models

@inject HttpClient Http

<PageTitle>Spacecraft Maintenance Station</PageTitle>

<main class="chat-page lobby-page">
    <h1>Week Schedule:</h1>

    @if (_isLoading) {
        <p>Checking bays schedules</p>
    }
    else if (_selectedBay is null) {
        <section>
            <h2>Select bay:</h2>

            @* TODO: форма выбора Bay, ниспадающий список *@
            <ul class="request-list">
                @foreach (var bay in _bays) {
                    <li>
                        <a href="@($"/maintenanceRequests?bayId={bay.Id}")">@bay.Name</a>
                    </li>
                }
            </ul>

        </section>

        @* <header class="bay-header">
            <p>Bay <strong>@_selectedBay.Name</strong></p>
        </header> *@

        <section>

            @if (_requests.Length == 0) {
                <p>No requests found</p>
            }
            else {
                @* TODO список заявок по BayId *@
                <ul class="request-list">
                    @foreach (var request in _requests) {
                        <li>
                            <a href="@($"/maintenanceRequests?bayId={request.BayId}")">@request.CustomerName - @request.ContactPhone - @request.LocalStartTime - @request.LocalEndTime</a>
                        </li>
                    }
                </ul>


                <RadzenScheduler @ref=@scheduler
                    AllowDateSelection="true" 
                    SlotRender=@OnSlotRender 
                    style="height: 768px;" 
                    TItem="MaintenanceRequestModel"
                    Data=@_requests
                    StartProperty="@nameof(MaintenanceRequestModel.LocalStartTime)"
                    EndProperty="@nameof(MaintenanceRequestModel.LocalEndTime)"
                    ShowHeader=@showHeader                                 
                    TextProperty="@nameof(MaintenanceRequestModel.CalendarText)"
                    SlotSelect=@OnSlotSelect 
                    AppointmentSelect=@OnAppointmentSelect 
                    AppointmentRender=@OnAppointmentRender 
                    DaySelect="@OnDaySelect"
                    AppointmentMove=@OnAppointmentMove 
                    AppointmentResize=@OnAppointmentResize
                 >
                    <RadzenWeekView StartTime="@TimeSpan.Zero"
                                    EndTime="@TimeSpan.FromHours(24)" />
                </RadzenScheduler>

            }
        </section>
    }
</main>

@code {
    RadzenScheduler<MaintenanceRequestModel> scheduler;
    bool showHeader = true;

    private bool _isLoading = true;

    private BayModel[] _bays = [];
    private BayModel _selectedBay;

    private MaintenanceRequestModel[] _requests = [];

    private async Task LoadBaysAsync()
    {
        _bays = await Http.GetFromJsonAsync<BayModel[]>($"api/bays") ?? [];
    }

    private async Task LoadMaintenanceRequestsAsync()
    {
        var timeNow = DateTime.UtcNow;
        var url = $"api/maintenanceRequests?bayId={_bays[0].Id}" +
                  $"&startTime={timeNow.AddDays(-6):O}&endTime={timeNow.AddDays(1):O}";

        _requests = await Http.GetFromJsonAsync<MaintenanceRequestModel[]>(url) ?? [];
    }

    protected override async Task OnInitializedAsync()
    {
        try {
            await LoadBaysAsync();
            await LoadMaintenanceRequestsAsync();
        }
        finally {
            _isLoading = false;
        }
    }

